  connect $auto$simplemap.cc:370:simplemap_lut$465 [6] 1'z
  connect $auto$simplemap.cc:370:simplemap_lut$465 [7] 1'z
  connect { \sr_in \cs \clk } { \__pi_sr_in \__pi_cs \__pi_clk }
  connect { \__po_sr_out \__po_gpioout } { \sr_out \gpioout }
end
