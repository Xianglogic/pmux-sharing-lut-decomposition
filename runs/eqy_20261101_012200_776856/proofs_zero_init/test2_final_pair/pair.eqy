[gold]
read_rtlil "evidence/current/capture_full/test2/baseline.final.formal.il"
delete =A:blackbox
delete =A:whitebox
read_verilog -overwrite "evidence/formal_primitives.v"
delete t:$print
prep -top test2 -flatten
memory_map
techmap
opt
clk2fflogic
opt_clean
check -assert

[gate]
read_rtlil "evidence/current/capture_full/test2/candidate.final.formal.il"
delete =A:blackbox
delete =A:whitebox
read_verilog -overwrite "evidence/formal_primitives.v"
delete t:$print
prep -top test2 -flatten
memory_map
techmap
opt
clk2fflogic
opt_clean
check -assert

[match *]
nodefault
gold-match clk
gold-match a
gold-match b
gold-match c
gold-match d
gold-match dataa
gold-match datab
gold-match datac
gold-match datad
gold-match out

[collect *]
group /^(?:out)(?:\[\d+\])?$/

[strategy pdr]
use sby
engine abc pdr
timeout 300
