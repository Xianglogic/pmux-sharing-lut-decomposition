  connect \gold.only_5b_$lut_Y_A_dffeas_q_d_$lut_Y_A_$lut_Y_A \gate.only_5b_$lut_Y_A_dffeas_q_d_$lut_Y_A_$lut_Y.dataa
  connect \gold.only_5b_$lut_Y_A_dffeas_q_d_$lut_Y_A_$lut_Y_A_1 \gate.only_5b_$lut_Y_A_dffeas_q_d_$lut_Y_A_$lut_Y.datab
  connect \gold.reset_n \__pi_reset_n
end
