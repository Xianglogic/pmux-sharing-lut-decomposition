[gold]
read_rtlil "evidence/current/capture_full/test3/baseline.boundary.formal.il"
delete =A:blackbox
delete =A:whitebox
read_verilog -overwrite "evidence/formal_primitives.v"
delete t:$print
prep -top test3 -flatten
memory_map
techmap
opt
clk2fflogic
opt_clean
check -assert

[gate]
read_rtlil "evidence/current/capture_full/test3/baseline.final.formal.il"
delete =A:blackbox
delete =A:whitebox
read_verilog -overwrite "evidence/formal_primitives.v"
delete t:$print
prep -top test3 -flatten
memory_map
techmap
opt
clk2fflogic
opt_clean
check -assert

[match *]
nodefault
gold-match clk
gold-match cs
gold-match sr_in
gold-match gpioout
gold-match sr_out

[collect *]
group /^(?:gpioout|sr_out)(?:\[\d+\])?$/

[strategy pdr]
use sby
engine abc pdr
timeout 300
